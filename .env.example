# Окружение приложения (local, test, server)
ENVIRONMENT=local
DEBUG=True

# Настройки безопасности и авторизации (JWT)
# В реальном .env сгенерируйте надежный случайный ключ (например: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Подключение к PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edutest_db

# Ключ к ИИ-провайдеру (Gemini / OpenAI) для авто-генерации тестов
AI_API_KEY=your_mock_or_dev_ai_api_key_here

# Настройки CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
